ggplot(subset(data, Gruppe != "NameDerGruppeDieRausSoll"), aes(x=KIM, y=Likert, fill=Gruppe)) +
geom_boxplot(alpha=0.75) +    # hier bezieht sich alpha auf die Transparenz der Farbe
ylim(1, 5) +
scale_fill_manual(values=c("#252653","#FFC50B", "#FFFFFF")) +       # Farbgebung
theme_bw() +
theme(legend.position="bottom", plot.title = element_text(size=11)) +
xlab("KIM Bereiche") +
ylab("Likert Skala")
head(data)
data$Gruppe
